{
  "manifest_version": 3,
  "name": "Partituras a PNG",
  "version": "1.0.0",
  "description": "Baja las páginas de una partitura de MuseScore como imágenes PNG del ancho que elijas.",
  "action": {
    "default_title": "Bajar esta partitura como PNG"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "host_permissions": ["https://musescore.com/*", "https://*.musescore.com/*"]
}
